---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");

// Homepage "Blogs" section: only personal writing, grouped into three
// filterable categories. Publications live on the Research tab instead.
const BLOG_CATEGORIES = [
  { key: "research", label: "Research" },
  { key: "dog", label: "Dog" },
  { key: "life", label: "Life" },
] as const;
const catKeys = BLOG_CATEGORIES.map(c => c.key) as readonly string[];
const blogPosts = recentPosts.filter(p =>
  p.data.tags.some(tag => catKeys.includes(tag))
);
const activeCategories = BLOG_CATEGORIES.filter(c =>
  blogPosts.some(p => p.data.tags.includes(c.key))
);
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout"
  >
    <section id="hero" class="hero-x">
      <div class="hero-grid" aria-hidden="true"></div>
      <div class="hero-glow" aria-hidden="true"></div>

      <div class="hero-meta">
        <span>PH.D. STUDENT · NTU SINGAPORE</span>
        <span class="hero-status"><i></i>OPEN TO COLLABORATION</span>
      </div>

      <div class="hero-body">
        <div class="hero-text">
          <p class="hero-kicker">all science is math · all models are wrong</p>
          <h1 class="hero-title">Jin&nbsp;Ziqi<span class="caret" aria-hidden="true"></span></h1>
          <p class="hero-cn">金子琪 <span class="hero-pinyin">/ Jīn Zǐqí /</span></p>
          <p class="hero-lead">
            2nd-year Ph.D. student at Nanyang Technological University, advised
            by Prof.&nbsp;Aixin&nbsp;Sun. I build language models that reason,
            and probe why they work.
          </p>

          <dl class="hero-cred">
            <div class="cred">
              <dt>NOW</dt>
              <dd>ByteDance</dd>
            </div>
            <div class="cred">
              <dt>PREVIOUSLY</dt>
              <dd>SEA&nbsp;AI&nbsp;Lab · MiroMind</dd>
            </div>
            <div class="cred">
              <dt>RESEARCH</dt>
              <dd>Efficient&nbsp;LLM · Optimisation · Diffusion&nbsp;LLM</dd>
            </div>
          </dl>

          <div class="hero-actions">
            <a class="chip" href="/cv.pdf" download>[ DOWNLOAD CV ]</a>
            <a class="chip" id="email-link" href="#" title="Email" data-email="ziqi007@e.ntu.edu.sg">[ EMAIL ]</a>
            <a class="chip" href="https://github.com/Xalp">[ GITHUB ]</a>
            <a class="chip" href="https://scholar.google.com/citations?user=on-f0-IAAAAJ">[ SCHOLAR ]</a>
          </div>
        </div>

        <figure class="hero-photo">
          <span class="tick tl" aria-hidden="true"></span>
          <span class="tick tr" aria-hidden="true"></span>
          <span class="tick bl" aria-hidden="true"></span>
          <span class="tick br" aria-hidden="true"></span>
          <div class="photo-frame">
            <img src="/images/profile-desk.jpg" width="255" height="255" alt="Jin Ziqi" loading="eager" />
            <span class="shine" aria-hidden="true"></span>
          </div>
          <figcaption>NTU · SG</figcaption>
        </figure>
      </div>
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-border border-b": recentPosts.length > 0 },
          ]}
        >
          <div class="section-head">
            <span class="section-index">01 / FEATURED</span>
            <h2 class="section-title">{t.home.featured}</h2>
          </div>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      blogPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <div class="section-head section-head--row">
            <div>
              <span class="section-index">02 / WRITING</span>
              <h2 class="section-title">Blogs</h2>
            </div>
            {activeCategories.length > 0 && (
              <div class="blog-filter" role="group" aria-label="Filter posts">
                <button class="filter-chip is-active" data-filter="all">
                  All
                </button>
                {activeCategories.map(c => (
                  <button class="filter-chip" data-filter={c.key}>
                    {c.label}
                  </button>
                ))}
              </div>
            )}
          </div>
          <ul id="blog-list">
            {blogPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const emailLink = document.getElementById("email-link");
    if (emailLink) {
      emailLink.addEventListener("click", (e) => {
        e.preventDefault();
        const em = emailLink.getAttribute("data-email");
        if (em) window.location.href = "mailto:" + em;
      });
    }

    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }

    // Blogs category filter
    const chips = Array.from(
      document.querySelectorAll<HTMLButtonElement>(".filter-chip")
    );
    const items = Array.from(
      document.querySelectorAll<HTMLLIElement>("#blog-list > li")
    );
    chips.forEach(chip => {
      chip.addEventListener("click", () => {
        const filter = chip.dataset.filter ?? "all";
        chips.forEach(c => c.classList.toggle("is-active", c === chip));
        items.forEach(li => {
          const show = filter === "all" || li.dataset.category === filter;
          li.classList.toggle("filtered-out", !show);
        });
      });
    });
  });
</script>

<style>
  /* ===== x.ai-inspired hero ===== */
  .hero-x {
    position: relative;
    overflow: hidden;
    padding: clamp(2.5rem, 8vw, 5rem) 0 clamp(2rem, 5vw, 3.5rem);
    border-bottom: 1px solid var(--border);
  }

  /* faint drifting grid */
  .hero-grid {
    position: absolute;
    inset: -2px;
    background-image:
      linear-gradient(to right, var(--border) 1px, transparent 1px),
      linear-gradient(to bottom, var(--border) 1px, transparent 1px);
    background-size: 44px 44px;
    opacity: 0.5;
    -webkit-mask-image: radial-gradient(ellipse 80% 70% at 30% 20%, #000 0%, transparent 75%);
    mask-image: radial-gradient(ellipse 80% 70% at 30% 20%, #000 0%, transparent 75%);
    animation: gridDrift 24s linear infinite;
    pointer-events: none;
  }
  @keyframes gridDrift {
    from { transform: translateY(0); }
    to   { transform: translateY(-44px); }
  }

  /* soft accent glow behind the name */
  .hero-glow {
    position: absolute;
    top: -20%;
    left: -10%;
    width: 55%;
    height: 120%;
    background: radial-gradient(circle, color-mix(in srgb, var(--accent) 26%, transparent) 0%, transparent 65%);
    filter: blur(30px);
    opacity: 0.55;
    pointer-events: none;
  }

  .hero-meta,
  .hero-body { position: relative; z-index: 1; }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    color: var(--muted-foreground);
    padding-bottom: 1.75rem;
  }
  .hero-status { display: inline-flex; align-items: center; gap: 0.5rem; }
  .hero-status i {
    width: 7px; height: 7px; border-radius: 999px;
    background: var(--accent);
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 70%, transparent);
    animation: pulse 2s ease-out infinite;
  }
  @keyframes pulse {
    0%   { box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 70%, transparent); }
    70%  { box-shadow: 0 0 0 7px transparent; }
    100% { box-shadow: 0 0 0 0 transparent; }
  }

  .hero-body {
    display: flex;
    align-items: center;
    gap: clamp(1.5rem, 5vw, 3.5rem);
  }
  .hero-text { flex: 1 1 auto; min-width: 0; }

  .hero-kicker {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: var(--accent);
    margin: 0 0 0.85rem;
  }

  .hero-title {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: clamp(2.6rem, 9vw, 5.25rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
    margin: 0;
    color: var(--foreground);
  }
  .caret {
    display: inline-block;
    width: 0.5ch;
    height: 0.82em;
    margin-left: 0.12em;
    background: var(--accent);
    transform: translateY(0.06em);
    animation: blink 1.05s steps(1) infinite;
  }
  @keyframes blink { 0%, 50% { opacity: 1; } 50.01%, 100% { opacity: 0; } }

  .hero-cn {
    margin: 0.65rem 0 0;
    font-size: clamp(1.15rem, 3vw, 1.5rem);
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--foreground);
  }
  .hero-pinyin {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.02em;
    color: var(--muted-foreground);
    margin-left: 0.35rem;
  }

  .hero-lead {
    margin: 1.35rem 0 0;
    max-width: 46ch;
    color: var(--muted-foreground);
    line-height: 1.6;
  }

  .hero-cred {
    margin: 1.6rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    border-left: 2px solid var(--accent);
    padding-left: 0.95rem;
  }
  .hero-cred .cred {
    display: flex;
    gap: 0.85rem;
    align-items: baseline;
    flex-wrap: wrap;
  }
  .hero-cred dt {
    flex: 0 0 auto;
    min-width: 5.5rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    color: var(--muted-foreground);
    padding-top: 0.1rem;
  }
  .hero-cred dd {
    margin: 0;
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--foreground);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.85rem;
  }
  .chip {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--border);
    color: var(--foreground);
    background: color-mix(in srgb, var(--muted) 25%, transparent);
    transition: all 0.22s ease;
    white-space: nowrap;
  }
  .chip:hover {
    background: var(--accent);
    color: var(--accent-foreground);
    border-color: var(--accent);
    transform: translateY(-2px);
    text-decoration: none;
  }

  /* photo panel */
  .hero-photo {
    position: relative;
    flex: 0 0 auto;
    width: clamp(150px, 26vw, 220px);
    margin: 0;
    padding: 8px;
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--muted) 20%, transparent);
  }
  .photo-frame {
    position: relative;
    overflow: hidden;
    line-height: 0;
  }
  .hero-photo img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .hero-photo:hover img { transform: scale(1.04); }
  /* shine sweep on hover */
  .photo-frame .shine {
    position: absolute;
    top: 0;
    left: -160%;
    width: 90%;
    height: 100%;
    transform: skewX(-22deg);
    background: linear-gradient(
      90deg,
      transparent 0%,
      color-mix(in srgb, #fff 55%, transparent) 50%,
      transparent 100%
    );
    pointer-events: none;
    z-index: 2;
  }
  .hero-photo:hover .shine { animation: shineSweep 0.85s ease; }
  @keyframes shineSweep {
    from { left: -160%; }
    to   { left: 160%; }
  }
  .hero-photo figcaption {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.18em;
    color: var(--muted-foreground);
    text-align: right;
    padding-top: 6px;
  }
  .hero-photo .tick {
    position: absolute;
    width: 8px; height: 8px;
    border: 1px solid var(--accent);
  }
  .tick.tl { top: -1px; left: -1px; border-right: 0; border-bottom: 0; }
  .tick.tr { top: -1px; right: -1px; border-left: 0; border-bottom: 0; }
  .tick.bl { bottom: -1px; left: -1px; border-right: 0; border-top: 0; }
  .tick.br { bottom: -1px; right: -1px; border-left: 0; border-top: 0; }

  @media (max-width: 640px) {
    .hero-body { flex-direction: column-reverse; align-items: flex-start; }
    .hero-photo { width: clamp(130px, 45vw, 180px); }
  }

  /* ===== section headers ===== */
  .section-head { margin-bottom: 1.5rem; }
  .section-head--row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .section-index {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    color: var(--accent);
    margin-bottom: 0.4rem;
  }
  .section-title {
    position: relative;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 1.7rem;
    letter-spacing: -0.01em;
    margin: 0;
    padding-left: 0.7rem;
    color: color-mix(in srgb, var(--foreground) 80%, var(--accent));
  }
  /* accent bar before the title for a bit more structure */
  .section-title::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.15em;
    bottom: 0.15em;
    width: 3px;
    border-radius: 2px;
    background: var(--accent);
  }

  /* ===== blog filter ===== */
  .blog-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .filter-chip {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    padding: 0.32rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--muted-foreground);
    background: transparent;
    transition: all 0.2s ease;
  }
  .filter-chip:hover {
    color: var(--foreground);
    border-color: var(--accent);
  }
  .filter-chip.is-active {
    background: var(--accent);
    color: var(--accent-foreground);
    border-color: var(--accent);
  }
  /* hidden by filter */
  #blog-list :global(li.filtered-out) { display: none; }

  @media (prefers-reduced-motion: reduce) {
    .hero-grid, .caret, .hero-status i, .shine { animation: none; }
  }
</style>
